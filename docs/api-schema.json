{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MedLensReportPayload",
  "type": "object",
  "required": ["patient", "metadata", "results"],
  "properties": {
    "patient": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "age": { "type": ["string", "number"] },
        "gender": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "reportDate": { "type": "string" },
        "laboratory": { "type": "string" },
        "contentHash": { "type": "string" }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_name", "value", "unit", "reference_range"],
        "properties": {
          "test_name": { "type": "string" },
          "value": { "type": "string" },
          "unit": { "type": "string" },
          "reference_range": { "type": ["string", "null"] },
          "category": { "type": "string" },
          "confidence": { "type": "number" },
          "provenance": {
            "type": "object",
            "properties": {
              "page": { "type": "number" },
              "line": { "type": "number" },
              "rawSnippet": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
